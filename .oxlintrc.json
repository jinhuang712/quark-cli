{
  // Used only for JS/TS projects without their own oxlint, eslint or biome config,
  // and only on the lines Claude changed.
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    // Too noisy for a default measured on real projects: fine-grained taste, not bugs.
    "typescript/no-unsafe-type-assertion": "off",
    "promise/always-return": "off",
    "import/no-unassigned-import": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-underscore-dangle": "off",
    // Commands run one Quark request after another on purpose: one page, and a drive that
    // flags bursts.
    "no-await-in-loop": "off"
  },
  "ignorePatterns": ["dist/**", "build/**", "out/**", "coverage/**", "**/*.min.js", "**/*.d.ts"]
}
